<div class="ml-auto lg:hidden"
     data-controller="menu"
     data-action="pointerdown@window->menu#closeOnOutside keydown.esc@window->menu#close
                  focusout->menu#closeOnFocusOut turbo:before-cache@document->menu#close">
  <button type="button" id="site-phone-menu-button"
          class="-mr-2 inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-ink"
          data-menu-target="button" data-action="click->menu#toggle"
          aria-label="<%= t("nav.menu") %>" aria-expanded="false" aria-controls="site-phone-menu">
    <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>

  <nav id="site-phone-menu" aria-label="<%= t("nav.menu") %>" data-menu-target="nav"
       class="vm-panel--raised hidden absolute inset-x-0 top-full z-[60] max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-b border-line bg-paper lg:hidden">
    <ul class="vm-container py-2 text-sm">
      <% featured_competitions.each do |competition| %>
        <li><%= render "layouts/phone_nav_link", label: competition.name, path: competition_path(slug: competition.slug) %></li>
      <% end %>
      <li><%= render "layouts/phone_nav_link", label: t("nav.hall_of_fame"), path: hall_path %></li>
      <li><%= render "layouts/phone_nav_link", label: t("nav.news"), path: news_index_path %></li>
      <li><%= render "layouts/phone_nav_link", label: t("nav.stats"), path: stats_path %></li>

      <% if user_signed_in? %>
        <% role_nav_items(current_user).each_with_index do |item, index| %>
          <li class="<%= "mt-2 border-t border-line pt-2" if index.zero? %>">
            <%= render "layouts/phone_nav_link", label: item.label, path: item.path %>
          </li>
        <% end %>
        <li class="mt-2 border-t border-line pt-2">
          <%= button_to t("nav.sign_out"), destroy_user_session_path,
                method: :delete,
                class: "flex min-h-11 w-full cursor-pointer items-center pl-3 text-left text-ink" %>
        </li>
      <% else %>
        <li class="mt-2 border-t border-line pt-2">
          <%= link_to t("nav.sign_in"), new_user_session_path, class: "flex min-h-11 items-center pl-3 text-ink" %>
        </li>
      <% end %>

      <li class="mt-2 flex min-h-11 items-center border-t border-line pl-3 pt-2">
        <%= render "layouts/locale_switcher",
              button_class: "inline-flex min-h-11 min-w-11 items-center justify-center text-ink-muted hover:text-ink hover:underline" %>
      </li>
    </ul>
  </nav>
</div>
