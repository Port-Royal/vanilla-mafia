<footer id="site-footer" class="vm-chrome border-t border-line text-ink-muted text-xs">
  <div class="vm-container flex flex-wrap items-center gap-x-6 gap-y-2 py-6">
    <span><%= t("footer.copyright", year: Date.current.year) %></span>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="<%= t("footer.links") %>">
      <%= link_to t("nav.hall_of_fame"), hall_path, class: "text-ink-muted" %>
      <%= link_to t("nav.news"), news_index_path, class: "text-ink-muted" %>
    </nav>
    <% if design_preference.switch_to_old? %>
      <%= button_to t("design.switch_to_old"), design_preference_path,
            params: { design: "old" },
            method: :patch,
            id: "design-switch-to-old",
            class: "text-ink-muted underline underline-offset-2 hover:no-underline cursor-pointer",
            form: { class: "inline sm:ml-auto" } %>
    <% end %>
  </div>
</footer>
