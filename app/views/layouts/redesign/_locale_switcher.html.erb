<div class="flex items-center gap-2 text-sm">
  <% I18n.available_locales.each_with_index do |loc, i| %>
    <% if i > 0 %><span class="text-ink-muted" aria-hidden="true">|</span><% end %>
    <% if loc == I18n.locale %>
      <span class="vm-locale-current font-bold text-ink"><%= loc.to_s.upcase %></span>
    <% else %>
      <%= button_to loc.to_s.upcase, locale_path(locale: loc),
            method: :patch,
            class: "text-ink-muted hover:text-ink hover:underline",
            form: { class: "inline" } %>
    <% end %>
  <% end %>
</div>
