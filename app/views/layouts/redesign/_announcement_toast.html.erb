<div class="vm-chrome fixed bottom-4 inset-x-4 z-50 lg:left-auto lg:right-4 lg:max-w-sm"
     data-controller="announcement-dismiss"
     data-announcement-dismiss-url-value="<%= announcement_dismissals_path %>">
  <div class="vm-panel vm-panel--raised p-4">
    <div class="mb-2 flex items-start justify-between gap-4">
      <h4 class="font-semibold text-ink"><%= t("home.whats_new.toast_title") %></h4>
      <button type="button"
              class="-mr-2 -mt-2 inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-xl leading-none text-ink-muted hover:text-ink lg:m-0 lg:min-h-0 lg:min-w-0"
              data-action="announcement-dismiss#dismiss"
              data-announcement-ids="<%= announcements.map(&:id).join(",") %>"
              aria-label="<%= t("home.whats_new.dismiss") %>">
        &times;
      </button>
    </div>

    <ul class="space-y-1">
      <% announcements.each do |announcement| %>
        <li class="text-sm text-ink"><%= announcement.localized_message %></li>
      <% end %>
    </ul>
  </div>
</div>
