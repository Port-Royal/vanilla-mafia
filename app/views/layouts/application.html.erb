<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <% if new_design? %>
    <body class="min-h-screen bg-paper font-sans" data-controller="time-zone">
      <%= render "layouts/redesign/shell", content: yield %>
    </body>
  <% else %>
    <body class="min-h-screen bg-white font-sans" data-controller="menu time-zone">
      <%= render "layouts/legacy/shell", content: yield %>
    </body>
  <% end %>
</html>
