<h1 class="vm-page-title mb-4"><%= t(".title", player_name: @player.name) %></h1>

<div class="dispute-rules vm-panel mb-6 max-w-lg p-4 text-sm text-ink">
  <ul class="list-disc space-y-1 pl-5">
    <% t(".rules").each do |rule| %>
      <li><%= rule %></li>
    <% end %>
  </ul>
</div>

<%= form_with url: player_dispute_path(@player), scope: :dispute, method: :post, multipart: true, class: "vm-panel max-w-lg space-y-4 p-6" do |f| %>
  <div>
    <%= f.label :evidence, t(".evidence_label"), class: "vm-field-label" %>
    <%= f.text_area :evidence, required: true, rows: 5, class: "vm-input" %>
  </div>

  <div>
    <%= f.label :selfie, t(".selfie_label"), class: "vm-field-label" %>
    <%= f.file_field :selfie, accept: "image/*", class: "vm-file" %>
  </div>

  <div>
    <%= f.label :documents, t(".documents_label"), class: "vm-field-label" %>
    <%= f.file_field :documents, multiple: true, class: "vm-file" %>
  </div>

  <p class="text-xs text-ink-muted"><%= t(".files_disclaimer") %></p>

  <div>
    <%= f.submit t(".submit"), class: "vm-btn vm-btn--primary" %>
  </div>
<% end %>
