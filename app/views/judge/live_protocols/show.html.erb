<div id="live-protocol-bar" class="mb-2 flex flex-wrap items-baseline gap-4">
  <h1 class="text-xl font-bold text-maroon"><%= @game.full_name %></h1>
  <% if @game.unfinished_from_past_day? %>
    <span class="unfinished-flag rounded bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800"><%= t("game_protocols.unfinished_game.flag") %></span>
  <% end %>
  <%= link_to t("live_protocols.edit_link"), edit_judge_protocol_path(@game), class: "text-maroon hover:underline text-sm" %>
  <span class="inline-flex items-baseline gap-2"
        data-controller="clipboard"
        data-clipboard-text-value="<%= table_overlay_url_for(@game) %>"
        data-clipboard-copied-value="<%= t("live_protocols.overlay_link.copied") %>">
    <button type="button"
            data-action="click->clipboard#copy"
            data-clipboard-target="button"
            class="rounded bg-maroon px-2 py-0.5 text-sm text-white hover:bg-maroon/90"><%= t("live_protocols.overlay_link.copy") %></button>
    <%= link_to t("live_protocols.overlay_link.game_only"), overlay_game_url(@game),
                target: "_blank", rel: "noopener", class: "text-xs text-gray-500 hover:underline" %>
  </span>
  <%= link_to t("live_protocols.list_link"), judge_protocols_path, class: "text-maroon hover:underline text-sm" %>
</div>
<div id="live-protocol"
     class="live-protocol"
     data-controller="live-protocol"
     data-live-protocol-game-id-value="<%= @game.id %>"
     data-live-protocol-events-url-value="<%= live_events_judge_protocol_path(@game) %>"
     data-live-protocol-after-finish-url-value="<%= edit_judge_protocol_path(@game) %>"
     data-live-protocol-players-value="<%= @players.to_json %>"
     data-live-protocol-events-value="<%= @events.to_json %>"
     data-live-protocol-texts-value="<%= t("live_protocols.screen").to_json %>"></div>
