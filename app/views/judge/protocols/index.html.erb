<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="vm-page-title"><%= t("game_protocols.index.title") %></h1>
  <%= link_to t("game_protocols.index.new_protocol"), new_judge_protocol_path, class: "vm-btn vm-btn--primary" %>
</div>

<% if @in_progress_games.any? %>
  <div class="vm-panel overflow-x-auto">
    <table class="vm-table">
      <thead>
        <tr>
          <th><%= Game.human_attribute_name(:game_number) %></th>
          <th><%= t("game_protocols.form.competition") %></th>
          <th><%= Game.human_attribute_name(:played_on) %></th>
          <th><%= t("game_protocols.form.judge") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @in_progress_games.each do |game| %>
          <tr>
            <td class="tabular-nums"><%= game.game_number %></td>
            <td><%= game.competition.name %></td>
            <td class="whitespace-nowrap tabular-nums">
              <%= game.played_on %>
              <% if game.unfinished_from_past_day? %>
                <span class="unfinished-flag vm-pill vm-pill--alert ml-2"><%= t("game_protocols.unfinished_game.flag") %></span>
              <% end %>
            </td>
            <td><%= game.judge %></td>
            <td class="text-right">
              <%= link_to t("game_protocols.index.edit"), edit_judge_protocol_path(game), class: "vm-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm text-ink-muted"><%= t("game_protocols.index.no_protocols") %></p>
<% end %>
