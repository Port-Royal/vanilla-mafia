<div class="vm-panel mb-6 p-4" data-controller="clipboard">
  <h2 class="vm-label mb-2"><%= t("game_protocols.edit.overlay_link.title") %></h2>
  <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap">
    <input type="text"
           readonly
           value="<%= table_overlay_url_for(game) %>"
           data-clipboard-target="source"
           class="vm-input min-w-0 text-ink-muted select-all sm:w-auto sm:flex-1">
    <button type="button"
            data-action="click->clipboard#copy"
            data-clipboard-target="button"
            class="vm-btn vm-btn--primary shrink-0">
      <%= t("game_protocols.edit.overlay_link.copy") %>
    </button>
    <%= link_to t("game_protocols.edit.overlay_link.open"), table_overlay_url_for(game),
                target: "_blank", rel: "noopener",
                class: "vm-btn vm-btn--ghost shrink-0" %>
  </div>
  <p class="mt-2 text-xs text-ink-muted">
    <%= t("game_protocols.edit.overlay_link.hint") %>
    <%= link_to t("game_protocols.edit.overlay_link.game_only"), overlay_game_url(game),
                target: "_blank", rel: "noopener", class: "vm-link" %>
    <%= link_to t("game_protocols.edit.overlay_link.help"), help_path(slug: "obs-overlay"), class: "vm-link" %>
  </p>
</div>
