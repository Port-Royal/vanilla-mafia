<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="vm-page-title"><%= t("game_breakdowns.index.title") %></h1>
  <%= link_to t("game_breakdowns.index.new_breakdown"), new_judge_breakdown_path, class: "vm-btn vm-btn--primary" %>
</div>

<% if @breakdowns.any? %>
  <div class="vm-panel overflow-x-auto">
    <table class="vm-table">
      <thead>
        <tr>
          <th><%= GameBreakdown.human_attribute_name(:title) %></th>
          <th><%= GameBreakdown.human_attribute_name(:played_on) %></th>
          <th><%= GameBreakdown.human_attribute_name(:author) %></th>
          <th><%= t("game_breakdowns.index.result") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @breakdowns.each do |breakdown| %>
          <tr>
            <td class="font-medium">
              <%= link_to breakdown.title, judge_breakdown_path(breakdown), class: "vm-link" %>
            </td>
            <td class="whitespace-nowrap tabular-nums"><%= breakdown.played_on %></td>
            <td><%= breakdown.author.display_name %></td>
            <td><%= breakdown_result_label(@results[breakdown.id]) %></td>
            <td class="text-right">
              <%= link_to t("game_breakdowns.index.edit"), edit_judge_breakdown_path(breakdown), class: "vm-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm text-ink-muted"><%= t("game_breakdowns.index.no_breakdowns") %></p>
<% end %>
