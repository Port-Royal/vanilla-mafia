<%= turbo_frame_tag dom_id(state.phase) do %>
  <div class="vm-panel">
    <div class="flex flex-col gap-1 border-b border-line px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between">
      <span class="text-base font-semibold text-ink"><%= state.label %></span>
      <span class="text-sm text-ink-muted">
        <%= t("game_breakdowns.editor.alive", seats: state.alive_at_start.join(", ")) %>
      </span>
    </div>

    <%= render "judge/breakdowns/warnings", warnings: @timeline.warnings_for(state.phase) %>

    <% if state.phase.night? %>
      <%= render "judge/breakdowns/night", state: state, seat_names: seat_names %>
    <% else %>
      <div class="divide-y divide-line-soft">
        <% state.opening_speeches.each do |speech| %>
          <%= render "judge/breakdowns/speech", speech: speech, state: state, seat_names: seat_names %>
        <% end %>

        <% state.vote_rounds.each do |result| %>
          <%= render "judge/breakdowns/vote_round", result: result, state: state, seat_names: seat_names %>
        <% end %>

        <% state.closing_speeches.each do |speech| %>
          <%= render "judge/breakdowns/speech", speech: speech, state: state, seat_names: seat_names %>
        <% end %>

        <%= render "judge/breakdowns/speech_form", state: state, seat_names: seat_names %>
      </div>
    <% end %>
  </div>
<% end %>
