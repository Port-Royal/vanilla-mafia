<div class="vm-panel">
  <div class="flex flex-col gap-1 border-b border-line px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between">
    <span class="text-base font-semibold text-ink"><%= state.label %></span>
    <span class="text-sm text-ink-muted">
      <%= t("game_breakdowns.editor.alive", seats: state.alive_at_start.join(", ")) %>
    </span>
  </div>

  <%= render "judge/breakdowns/warnings", warnings: @timeline.warnings_for(state.phase) %>

  <div class="px-4 py-3 text-sm">
    <% if state.phase.night? %>
      <p><%= breakdown_night_summary(state.phase, seat_names, roles_by_seat, filter: @seat_filter).join(" · ") %></p>
    <% else %>
      <%= render "judge/breakdowns/view_day", state: state, seat_names: seat_names %>
    <% end %>
  </div>
</div>
