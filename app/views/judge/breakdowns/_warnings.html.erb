<% if warnings.any? %>
  <ul class="vm-warnings">
    <% warnings.each do |warning| %>
      <li>
        <%= warning.message %>
        <% if warning.rule %>
          <span class="text-label">(<%= t("game_breakdowns.editor.rule", rule: warning.rule) %>)</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
