<%= form_with model: seat, url: judge_breakdown_seat_path(@breakdown, seat), method: :patch, scope: :breakdown_seat,
      id: dom_id(seat), data: { seat_number: seat.number, controller: "autosave-form",
                                action: "change->autosave-form#submit input->autosave-form#submitLater" } do |form| %>
  <div class="flex flex-col sm:flex-row sm:items-center px-4 py-2 gap-2">
    <span class="w-8 font-semibold text-sm text-center"><%= seat.number %></span>
    <div class="relative overflow-visible w-full sm:w-64" data-controller="player-select">
      <%= form.text_field :name, autocomplete: "off", id: "#{dom_id(seat)}_name",
            class: "w-full border border-gray-300 rounded-md px-2 py-1 text-sm",
            data: { player_select_target: "search",
                    action: "focus->player-select#open input->player-select#filter keydown->player-select#onKeydown blur->player-select#scheduleClose" } %>
      <div class="hidden fixed border border-gray-300 rounded-md bg-white shadow-sm max-h-60 overflow-y-auto z-50"
           data-player-select-target="menu"></div>
    </div>
    <%= form.collection_select :role_code, @roles, :code, :name, { include_blank: true },
          id: "#{dom_id(seat)}_role_code", class: "w-full sm:w-48 border border-gray-300 rounded-md px-2 py-1 text-sm" %>
    <span class="text-xs text-gray-500">
      <%= seat.player ? t("game_breakdowns.editor.linked_player", name: seat.player.name) : t("game_breakdowns.editor.unlinked_player") %>
    </span>
  </div>
<% end %>
