<div id="<%= dom_id(speech) %>" class="px-4 py-3">
  <div class="flex flex-wrap items-baseline gap-2">
    <span class="font-medium"><%= breakdown_seat_label(seat_names, speech.speaker_seat) %></span>
    <span class="text-sm text-gray-500"><%= t("game_breakdowns.speech_kinds.#{speech.kind}") %></span>
    <span class="grow"></span>
    <%= button_to t("game_breakdowns.editor.delete_speech"), judge_breakdown_speech_path(@breakdown, speech),
          method: :delete,
          form: { data: { turbo_confirm: t("game_breakdowns.editor.delete_speech_confirm") } },
          class: "text-xs text-maroon hover:underline" %>
  </div>

  <%= render "judge/breakdowns/warnings", warnings: @timeline.warnings_for(speech) %>

  <%= form_with model: speech, url: judge_breakdown_speech_path(@breakdown, speech), method: :patch, scope: :breakdown_speech,
        namespace: dom_id(speech),
        data: { controller: "autosave-form", action: "change->autosave-form#submit input->autosave-form#submitLater" } do |form| %>
    <%= form.text_area :summary, rows: 2, placeholder: t("game_breakdowns.editor.speech_summary_hint"),
          aria: { label: BreakdownSpeech.human_attribute_name(:summary) },
          class: "mt-2 w-full border border-gray-300 rounded-md px-2 py-1 text-sm" %>
  <% end %>

  <%= render "judge/breakdowns/moves", moves: speech.moves, context: speech, state: state, seat_names: seat_names %>
</div>
