<ul class="mt-2 space-y-1">
  <% moves.each do |move| %>
    <%= render "judge/breakdowns/move", move: move, state: state, seat_names: seat_names %>
  <% end %>
</ul>

<details class="mt-2">
  <summary class="text-xs text-maroon cursor-pointer"><%= t("game_breakdowns.editor.add_move") %></summary>
  <%= form_with model: BreakdownMove.new(breakdown_move_defaults(context, state)),
        url: judge_breakdown_moves_path(@breakdown, context.move_context_param),
        method: :post, scope: :breakdown_move do |form| %>
    <%= render "judge/breakdowns/move_fields", form: form, state: state, seat_names: seat_names,
          submit_label: t("game_breakdowns.editor.save_move") %>
  <% end %>
</details>
