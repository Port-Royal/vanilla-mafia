<% if @breakdown.errors.any? %>
  <div class="vm-errors mb-4">
    <%= @breakdown.errors.full_messages.to_sentence %>
  </div>
<% end %>

<div class="vm-panel mb-6 divide-y divide-line-soft">
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :title, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.text_field :title, required: true, class: "vm-input" %>
  </div>
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :played_on, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.date_field :played_on, class: "vm-input" %>
  </div>
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :video_url, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.url_field :video_url, class: "vm-input" %>
  </div>
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :judge_name, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.text_field :judge_name, class: "vm-input" %>
  </div>
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :roles_mode, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.select :roles_mode,
          GameBreakdown.roles_modes.keys.map { |mode| [ t("game_breakdowns.roles_modes.#{mode}"), mode ] },
          {}, class: "vm-input" %>
  </div>
  <div class="flex flex-col sm:flex-row items-center px-4 py-3 gap-2">
    <%= form.label :game_id, class: "w-40 shrink-0 text-sm font-semibold text-ink sm:text-right" %>
    <%= form.collection_select :game_id, @games, :id, :full_name, { include_blank: true },
          class: "vm-input" %>
  </div>
</div>

<div class="flex justify-end">
  <button type="submit" class="vm-btn vm-btn--primary">
    <%= t("game_breakdowns.form.submit") %>
  </button>
</div>
