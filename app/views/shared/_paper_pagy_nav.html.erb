<%# Pagination nav for pagy, used by every paginated screen.
     Usage: render "shared/paper_pagy_nav", pagy: @pagy %>
<% if pagy.pages > 1 %>
  <%
    base_classes     = "inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border px-3 text-sm tabular-nums"
    link_classes     = "#{base_classes} border-[#d8cba9] text-ink hover:bg-gold-wash"
    current_classes  = "#{base_classes} border-ink bg-ink font-semibold text-gold-bright"
    disabled_classes = "#{base_classes} border-line text-ink-muted cursor-default"
    gap_classes      = "px-2 text-sm text-ink-muted"
  %>
  <nav class="mt-6 flex flex-wrap items-center justify-center gap-1" aria-label="<%= t("pagy.aria_label.nav") %>">
    <% if pagy.previous %>
      <%= link_to t("pagy.prev"), pagy.page_url(pagy.previous), class: link_classes,
            aria: { label: t("pagy.aria_label.prev") } %>
    <% else %>
      <span class="<%= disabled_classes %>" aria-disabled="true"><%= t("pagy.prev") %></span>
    <% end %>

    <% pagy.series.each do |item| %>
      <% case item
         when Integer %>
        <%= link_to item, pagy.page_url(item), class: link_classes %>
      <% when String %>
        <span class="<%= current_classes %>" aria-current="page"><%= item %></span>
      <% when :gap %>
        <span class="<%= gap_classes %>">&hellip;</span>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to t("pagy.next"), pagy.page_url(pagy.next), class: link_classes,
            aria: { label: t("pagy.aria_label.next") } %>
    <% else %>
      <span class="<%= disabled_classes %>" aria-disabled="true"><%= t("pagy.next") %></span>
    <% end %>
  </nav>
<% end %>
