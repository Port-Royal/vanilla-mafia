<div class="mx-auto max-w-sm">
  <h1 class="vm-page-title mb-4"><%= t(".title") %></h1>

  <%= form_with(model: current_user, url: notification_settings_path, method: :patch) do |f| %>
    <div class="vm-panel space-y-4 p-6">
      <div>
        <div class="flex items-center gap-3">
          <%= f.check_box :notify_on_news_draft, class: "size-4 accent-ink" %>
          <%= f.label :notify_on_news_draft, t(".notify_on_news_draft_label"), class: "text-sm font-medium text-ink" %>
        </div>
        <p class="mt-1 text-xs text-ink-muted"><%= t(".notify_on_news_draft_hint") %></p>
      </div>

      <div>
        <%= f.submit t(".save"), class: "vm-btn vm-btn--primary w-full" %>
      </div>
    </div>
  <% end %>
</div>
