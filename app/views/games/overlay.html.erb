<% seat_roles = overlay_seat_roles(@participations_by_seat) %>

<div id="game-overlay"
     data-controller="game-overlay"
     data-game-overlay-game-id-value="<%= @game.id %>"
     data-game-overlay-role-badges-value="<%= GamesHelper::OVERLAY_ROLE_BADGE_CODES.index_with { |code| overlay_role_badge(code) }.to_json %>"
     data-game-overlay-default-photo-value="<%= Player::DEFAULT_PHOTO_PATH %>"
     data-game-overlay-seat-roles-value="<%= seat_roles.to_json %>"
     data-game-overlay-best-move-colours-value="<%= GamesHelper::OVERLAY_BEST_MOVE_COLOURS.to_json %>"
     data-game-overlay-table-template-value="<%= t("games.overlay.table", number: "%VALUE%") %>"
     data-game-overlay-judge-template-value="<%= t("games.overlay.judge", name: "%VALUE%") %>"
     data-game-overlay-game-template-value="<%= t("games.overlay.game", number: "%NUMBER%") %>"
     data-game-overlay-game-of-total-template-value="<%= t("games.overlay.game_of_total", number: "%NUMBER%", total: "%TOTAL%") %>"
     class="<%= overlay_canvas_class(@game) %>">
  <div class="overlay-header">
    <div id="overlay-table" class="justify-self-start" data-game-overlay-target="table"><%= overlay_table_label(@game) %></div>
    <div id="overlay-game-number" class="justify-self-center"
         data-game-overlay-target="gameNumber"
         data-number="<%= @game.game_number %>"
         data-total="<%= @game.games_total %>"><%= overlay_game_label(@game) %></div>
    <div id="overlay-judge" class="justify-self-end" data-game-overlay-target="judge"><%= overlay_judge_label(@game) %></div>
  </div>

  <% GamesHelper::OVERLAY_ELIMINATED_STATUSES.each do |status| %>
    <template data-game-overlay-target="statusIconTemplate" data-status="<%= status %>"><%= overlay_status_icon(status) %></template>
  <% end %>

  <div class="overlay-tiles">
    <% (1..10).each do |seat| %>
      <% participation = @participations_by_seat[seat] %>
      <% player = participation ? participation.player : nil %>
      <% status = overlay_player_status(participation) %>
      <div id="seat-<%= seat %>"
           class="<%= class_names("overlay-tile relative flex flex-col rounded-[0.4em] bg-black/40", "overlay-tile--eliminated" => overlay_eliminated?(status)) %>"
           data-game-overlay-target="tile"
           data-seat="<%= seat %>">
        <div class="overlay-photo min-h-0 flex-1">
          <% if player && player.photo.attached? %>
            <%= image_tag player.photo.variant(resize_to_fill: [ 300, 400 ]),
                          alt: player.name,
                          class: "h-full w-full object-cover",
                          data: { game_overlay_target: "photo", seat: seat } %>
          <% else %>
            <%= image_tag Player::DEFAULT_PHOTO_PATH,
                          alt: player ? player.name : "",
                          class: "h-full w-full object-cover",
                          data: { game_overlay_target: "photo", seat: seat } %>
          <% end %>
        </div>

        <div class="overlay-role-badge" data-game-overlay-target="roleBadge" data-seat="<%= seat %>"><%= overlay_role_badge(participation ? participation.role_code : nil) %></div>

        <div class="overlay-status-icon" data-game-overlay-target="status" data-seat="<%= seat %>"><%= overlay_status_icon(status) %></div>

        <div class="overlay-best-move" data-game-overlay-target="bestMove" data-seat="<%= seat %>"><% overlay_best_move_cells(participation, seat_roles).each do |named_seat, colour| %><span class="overlay-best-move-cell" data-named-seat="<%= named_seat %>" data-colour="<%= colour %>"><%= named_seat %></span><% end %></div>

        <div class="overlay-bottom flex items-stretch bg-black/70 font-semibold">
          <div class="overlay-seat flex-none bg-white/15 px-[0.4em] text-center"><%= seat %></div>
          <div class="overlay-name min-w-0 flex-1 truncate px-[0.4em]"
               data-game-overlay-target="playerName"
               data-seat="<%= seat %>"><%= player ? player.name : "" %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
