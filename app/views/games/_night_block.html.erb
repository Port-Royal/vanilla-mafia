<%# One row per kind of night event, one cell per night. game_overlay_controller.js redraws the cells live. %>
<% icons = {
  shots: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v6M12 16v6M2 12h6M16 12h6" stroke="currentColor" stroke-width="2"/></svg>',
  don: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h10l1 9H6z" fill="currentColor"/><path d="M2 16c3-2 17-2 20 0v2H2z" fill="currentColor"/></svg>',
  sheriff: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7z" fill="currentColor"/></svg>'
} %>
<div id="overlay-night" class="overlay-night" data-game-overlay-target="night" <%= "hidden" if rows[:nights].zero? %>>
  <div class="overlay-night-row" data-row="nights">
    <span class="overlay-night-icon"></span>
    <span class="overlay-night-cells" data-game-overlay-target="nightNumbers"><% (1..rows[:nights]).each do |night| %><span class="overlay-night-number"><%= night %></span><% end %></span>
  </div>
  <% %i[shots don sheriff].each do |row| %>
    <div class="overlay-night-row" data-row="<%= row %>" data-game-overlay-target="<%= row %>Row" title="<%= t("games.overlay.night.#{row}") %>" <%= "hidden" if row != :shots && rows[row].empty? %>>
      <span class="overlay-night-icon"><%= icons.fetch(row).html_safe %></span><%# rubocop:disable Rails/OutputSafety %>
      <span class="overlay-night-cells" data-game-overlay-target="<%= row %>Cells"><% rows[row].each do |cell| %><%= tag.span(cell[:text], class: "overlay-night-cell", data: { colour: cell[:colour], mark: cell[:mark] }) %><% end %></span>
    </div>
  <% end %>
</div>
