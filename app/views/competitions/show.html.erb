<% content_for :title, page_title(*competition_title_parts(@competition)) %>
<%= render "competitions/header", competition: @competition %>

<% if @parent_view %>
  <%= render "competitions/parent", competition: @competition, players: @players,
             games_by_child: @games_by_child, child_winners: @child_winners %>
<% else %>
  <%= render "competitions/leaf", games: @games, players_sorted: @players_sorted,
             participations_by_player: @participations_by_player %>
<% end %>

<% if @news.any? %>
  <section id="competition-news" aria-labelledby="news-cards-label" class="mt-8">
    <%= render "shared/news_cards", articles: @news, heading: t("competitions.redesign.news"), all_link: nil %>
  </section>
<% end %>
