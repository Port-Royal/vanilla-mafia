<div class="space-y-8">
  <% if players.any? %>
    <section id="competition-rating" aria-labelledby="competition-rating-label">
      <h2 id="competition-rating-label" class="vm-label mb-2"><%= t("competitions.redesign.rating") %></h2>
      <div class="vm-panel overflow-hidden">
        <table class="vm-table">
          <thead>
            <tr>
              <th scope="col" class="w-8"><%= t("competitions.show.rank") %></th>
              <th scope="col"><%= t("competitions.show.player") %></th>
              <th scope="col" class="text-right"><%= t("competitions.show.rating") %></th>
              <th scope="col" class="hidden text-right lg:table-cell"><%= t("competitions.show.games") %></th>
              <th scope="col" class="hidden text-right lg:table-cell"><%= t("competitions.show.win_rate") %></th>
            </tr>
          </thead>
          <tbody>
            <% players.each_with_index do |player, index| %>
              <% rank = index + 1 %>
              <% games_count = t("competitions.redesign.games_count", count: player.games_count) %>
              <% win_rate = "#{win_percentage(player)}%" %>
              <tr>
                <td>
                  <span class="vm-medal <%= rank <= 3 ? "vm-medal--#{rank}" : "text-ink-muted" %>"><%= rank %></span>
                </td>
                <td>
                  <%= link_to player.name, player_path(player), class: "font-semibold text-ink hover:underline" %>
                  <span class="vm-sub lg:hidden"><%= games_count %> · <%= win_rate %></span>
                </td>
                <td data-column="rating" class="text-right font-bold tabular-nums"><%= format_score(player.total_rating) %></td>
                <td data-column="games" class="hidden text-right tabular-nums lg:table-cell"><%= player.games_count %></td>
                <td data-column="win_rate" class="hidden text-right tabular-nums lg:table-cell"><%= win_rate %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section id="competition-children" aria-labelledby="competition-children-label">
    <h2 id="competition-children-label" class="vm-label mb-2"><%= children_label(competition) %></h2>
    <div class="vm-panel overflow-hidden">
      <table class="vm-table">
        <tbody>
          <% games_by_child.each do |child, games| %>
            <% winner = child_winners[child] %>
            <tr data-competition="<%= child.slug %>">
              <td>
                <div class="lg:flex lg:items-start lg:gap-4">
                  <div class="lg:w-1/3 lg:flex-none">
                    <%= link_to child.name, competition_path(slug: child.slug),
                          class: "font-semibold text-ink underline decoration-gold-line underline-offset-3 hover:decoration-ink" %>
                    <span class="vm-sub">
                      <%= child.ended_on.nil? ? t("competitions.redesign.running_short") : competition_dates(child) %>
                      <% if winner %>
                        · <%= t("competitions.redesign.winner") %>
                        <%= link_to winner.name, player_path(winner),
                              class: "text-ink underline decoration-gold-line underline-offset-2 hover:decoration-ink" %>
                      <% end %>
                    </span>
                  </div>
                  <% if games.any? %>
                    <div class="mt-1.5 flex flex-wrap gap-1.5 lg:mt-0">
                      <% games.each do |game| %>
                        <%= link_to game.game_number, game_path(game),
                              class: "rounded-md border bg-paper px-1.5 text-xs text-ink tabular-nums hover:bg-gold-wash #{game.in_progress? ? "border-gold" : "border-line"}" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
