<% content_for :title, page_title(t("errors.#{@code}.title")) %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<section id="error-page" aria-labelledby="error-title" class="mx-auto flex max-w-xl flex-col items-center py-16 text-center lg:py-24">
  <p data-error-code aria-hidden="true" class="font-serif text-[72px] leading-none font-bold text-gold-line tabular-nums lg:text-[112px]"><%= @code %></p>
  <span aria-hidden="true" class="mt-6 block h-0.5 w-12 rounded-full bg-gold"></span>
  <h1 id="error-title" class="mt-6 font-serif text-[22px] font-bold text-ink lg:text-[28px]"><%= t("errors.#{@code}.title") %></h1>
  <p data-error-message class="mt-2 text-[15px] leading-relaxed text-ink-muted"><%= t("errors.#{@code}.message") %></p>
  <%= link_to t("errors.back_home"), root_path, class: "vm-btn vm-btn--primary mt-8" %>
</section>
