<section id="home-recently-finished" aria-labelledby="home-recently-finished-label">
  <h2 id="home-recently-finished-label" class="vm-label mb-2"><%= t("home.redesign.recently_finished") %></h2>
  <ul class="vm-panel divide-y divide-line-soft">
    <% competitions.each do |competition| %>
      <% winner = winners[competition] %>
      <li class="px-3 py-2.5">
        <%= link_to competition.name, competition_path(slug: competition.slug),
              class: "text-sm font-semibold text-ink hover:underline" %>
        <span class="vm-sub">
          <%= format_date(competition.ended_on) %>
          <% if winner %>
            · <%= t("home.redesign.winner") %>
            <%= link_to winner.name, player_path(winner),
                  class: "text-ink underline decoration-[#e0cf9f] underline-offset-2 hover:decoration-ink" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</section>
