<section id="home-news" aria-labelledby="home-news-label">
  <div class="mb-2 flex items-baseline justify-between gap-3">
    <h2 id="home-news-label" class="vm-label"><%= t("home.redesign.news") %></h2>
    <%= link_to t("home.redesign.all_news"), news_index_path,
          class: "text-xs text-ink-muted underline decoration-[#e0cf9f] underline-offset-2 hover:decoration-ink" %>
  </div>
  <div class="vm-panel divide-y divide-line-soft">
    <% articles.each do |article| %>
      <% photo = article.photos.find(&:variable?) %>
      <% excerpt = article.truncated_content(160).to_plain_text %>
      <article class="flex gap-3 p-3">
        <% if photo %>
          <%= image_tag news_photo_variant(photo, :card), alt: "", width: 80, height: 60,
                class: "h-15 w-20 flex-none rounded-md object-cover" %>
        <% end %>
        <div class="min-w-0">
          <%= link_to article.title, news_path(article),
                class: "block text-sm font-semibold text-ink hover:underline" %>
          <span class="vm-sub">
            <%= safe_join([ (format_date(article.published_at) if article.published_at),
                            (article.author.player.name if article.author.claimed_player?) ].compact,
                          " · ") %>
          </span>
          <% if excerpt.present? %>
            <p class="mt-1 text-[13px] leading-snug text-ink"><%= excerpt %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
