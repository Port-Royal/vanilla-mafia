<h1 class="vm-page-title mb-6"><%= t("admin_telegram.title") %></h1>

<div class="space-y-8">
  <%# Webhook Status %>
  <section class="vm-panel p-6">
    <h2 class="mb-4 text-lg font-semibold text-ink"><%= t("admin_telegram.webhook.title") %></h2>

    <% if @webhook_info.success %>
      <% if @webhook_info.url.present? %>
        <div class="space-y-2 text-sm">
          <p>
            <span class="vm-pill vm-pill--gold"><%= t("admin_telegram.webhook.active") %></span>
          </p>
          <p><span class="font-medium"><%= t("admin_telegram.webhook.url") %>:</span> <code class="rounded bg-gold-wash px-1 font-mono text-[13px]"><%= @webhook_info.url %></code></p>
          <p><span class="font-medium"><%= t("admin_telegram.webhook.pending_updates") %>:</span> <%= @webhook_info.pending_update_count %></p>
        </div>
      <% else %>
        <p class="text-sm">
          <span class="vm-pill vm-pill--neutral"><%= t("admin_telegram.webhook.inactive") %></span>
        </p>
      <% end %>
    <% else %>
      <p class="text-sm text-alert-ink"><%= t("admin_telegram.webhook.error", message: @webhook_info.description) %></p>
    <% end %>
  </section>

  <%# Author Whitelist %>
  <section class="vm-panel p-6">
    <h2 class="mb-4 text-lg font-semibold text-ink"><%= t("admin_telegram.authors.title") %></h2>

    <% if @telegram_authors.any? %>
      <div class="mb-4 overflow-x-auto">
        <table class="vm-table">
          <thead>
            <tr>
              <th><%= t("admin_telegram.authors.user_id") %></th>
              <th><%= t("admin_telegram.authors.player") %></th>
              <th><%= t("admin_telegram.authors.linked_user") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @telegram_authors.each do |author| %>
              <tr>
                <td class="tabular-nums"><%= author.telegram_user_id %></td>
                <td>
                  <%= form_with model: author, url: admin_telegram_author_path(author), method: :patch, class: "flex items-center gap-2" do |f| %>
                    <%= f.select :player_id, options_for_select(@players.map { |p| [p.name, p.id] }, author.player_id), { include_blank: true }, class: "vm-input vm-input--sm w-auto" %>
                    <%= f.submit t("admin_telegram.authors.save"), class: "vm-btn vm-btn--ghost" %>
                  <% end %>
                </td>
                <td><%= author.user.email if author.user %></td>
                <td class="text-right">
                  <%= button_to t("admin_telegram.authors.remove"),
                        admin_telegram_author_path(author),
                        method: :delete,
                        class: "vm-link cursor-pointer text-alert-ink",
                        data: { turbo_confirm: t("admin_telegram.authors.remove_confirm") } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mb-4 text-sm text-ink-muted"><%= t("admin_telegram.authors.empty") %></p>
    <% end %>

    <h3 class="mb-2 text-sm font-semibold text-ink"><%= t("admin_telegram.authors.add") %></h3>
    <%= form_with model: @telegram_author, url: admin_telegram_authors_path, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :telegram_user_id, t("admin_telegram.authors.user_id"), class: "vm-field-label text-xs" %>
        <%= f.number_field :telegram_user_id, class: "vm-input w-auto", required: true %>
      </div>
      <div>
        <%= f.label :user_id, t("admin_telegram.authors.linked_user"), class: "vm-field-label text-xs" %>
        <%= f.select :user_id, options_for_select(@users.map { |u| [u.player.name, u.id] }, f.object.user_id), { include_blank: true }, class: "vm-input w-auto" %>
      </div>
      <div>
        <%= f.label :player_id, t("admin_telegram.authors.player"), class: "vm-field-label text-xs" %>
        <%= f.select :player_id, options_for_select(@players.map { |p| [p.name, p.id] }, f.object.player_id), { include_blank: true }, class: "vm-input w-auto" %>
      </div>
      <%= f.submit t("admin_telegram.authors.add_submit"), class: "vm-btn vm-btn--primary" %>
    <% end %>
  </section>
</div>
