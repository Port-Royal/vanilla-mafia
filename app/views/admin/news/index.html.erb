<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="vm-page-title"><%= t("admin_news.index.title") %></h1>
  <%= link_to t("admin_news.index.new"), new_admin_news_path, class: "vm-btn vm-btn--primary" %>
</div>

<% active_filter = News.statuses.key?(params[:status]) ? params[:status] : nil %>
<nav class="mb-4 flex flex-wrap gap-2" aria-label="<%= News.human_attribute_name(:status) %>">
  <% [ [ nil, t("admin_news.index.filter.all") ], [ "draft", t("admin_news.index.filter.draft") ],
       [ "published", t("admin_news.index.filter.published") ] ].each do |status, label| %>
    <%= link_to label, admin_news_index_path(status: status),
          aria: { current: (active_filter == status) || nil },
          class: "vm-btn #{active_filter == status ? 'vm-btn--primary' : 'vm-btn--ghost'}" %>
  <% end %>
</nav>

<% if @news.any? %>
  <div class="vm-panel overflow-x-auto">
    <table class="vm-table">
      <thead>
        <tr>
          <th><%= News.human_attribute_name(:title) %></th>
          <th><%= t("admin_news.index.author") %></th>
          <th><%= News.human_attribute_name(:status) %></th>
          <th><%= News.human_attribute_name(:created_at) %></th>
          <th><%= News.human_attribute_name(:published_at) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @news.each do |article| %>
          <tr>
            <td>
              <%= link_to truncate(article.title, length: 100), admin_news_path(article), class: "vm-link font-medium" %>
            </td>
            <td>
              <% if article.author.player %>
                <%= link_to article.author.player.name, player_path(article.author.player), class: "vm-link" %>
              <% else %>
                <%= article.author.email %>
              <% end %>
            </td>
            <td>
              <span class="vm-pill <%= article.published? ? 'vm-pill--gold' : 'vm-pill--neutral' %>">
                <%= t("admin_news.status.#{article.status}") %>
              </span>
            </td>
            <td class="whitespace-nowrap tabular-nums"><%= format_date(article.created_at) %></td>
            <td class="whitespace-nowrap tabular-nums"><%= format_datetime(article.published_at) %></td>
            <td class="text-right whitespace-nowrap">
              <%= link_to t("admin_news.index.edit"), edit_admin_news_path(article), class: "vm-link" %>
              <% if article.published? %>
                <%= button_to t("admin_news.index.unpublish"), unpublish_admin_news_path(article),
                      method: :patch,
                      data: { turbo_confirm: t("admin_news.index.unpublish_confirm") },
                      form_class: "inline",
                      class: "vm-link ml-3 cursor-pointer" %>
              <% end %>
              <% if article.draft? && policy(article).destroy? %>
                <%= button_to t("admin_news.index.delete"), admin_news_path(article),
                      method: :delete,
                      data: { turbo_confirm: t("admin_news.index.delete_confirm") },
                      form_class: "inline",
                      class: "vm-link ml-3 cursor-pointer text-alert-ink" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/paper_pagy_nav", pagy: @pagy %>
<% else %>
  <p class="text-sm text-ink-muted"><%= t("admin_news.index.empty") %></p>
<% end %>
