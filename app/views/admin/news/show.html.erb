<div class="mb-4">
  <%= link_to t("admin_news.show.back"), admin_news_index_path, class: "vm-link text-xs text-ink-muted" %>
</div>

<article class="vm-panel mb-6 p-6">
  <div class="mb-3 flex items-start justify-between gap-3">
    <h1 class="vm-page-title"><%= @news.title %></h1>
    <span class="vm-pill <%= @news.published? ? 'vm-pill--gold' : 'vm-pill--neutral' %>">
      <%= t("admin_news.status.#{@news.status}") %>
    </span>
  </div>

  <div class="mb-4 text-sm text-ink-muted">
    <%= t("admin_news.show.by_author", author: @news.author.email) %>
    <% if @news.competition %>
      · <%= t("admin_news.show.linked_competition", competition: @news.competition.name) %>
    <% end %>
    <% if @news.game %>
      · <%= t("admin_news.show.linked_game", game: @news.game.full_name) %>
    <% end %>
    · <%= t("admin_news.show.created_at", date: format_date(@news.created_at)) %>
    <% if @news.published_at %>
      · <%= format_datetime(@news.published_at) %>
    <% end %>
  </div>

  <%= render "news/photos", photos: @news.photos, alt: @news.title, size: :full %>

  <div class="news-prose max-w-none text-ink">
    <%= @news.content %>
  </div>
</article>

<div class="flex flex-wrap gap-2">
  <%= link_to t("admin_news.show.edit"), edit_admin_news_path(@news), class: "vm-btn vm-btn--primary" %>
  <% if @news.draft? %>
    <%= button_to t("admin_news.show.publish"), publish_admin_news_path(@news),
          method: :patch,
          class: "vm-btn vm-btn--ghost" %>
  <% end %>
  <% if @news.published? %>
    <%= button_to t("admin_news.show.unpublish"), unpublish_admin_news_path(@news),
          method: :patch,
          data: { turbo_confirm: t("admin_news.show.unpublish_confirm") },
          class: "vm-btn vm-btn--ghost" %>
  <% end %>
  <% if policy(@news).destroy? %>
    <%= button_to t("admin_news.show.delete"), admin_news_path(@news),
          method: :delete,
          data: { turbo_confirm: t("admin_news.show.delete_confirm") },
          class: "vm-btn vm-btn--danger" %>
  <% end %>
</div>
