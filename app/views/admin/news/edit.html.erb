<h1 class="vm-page-title mb-1"><%= t("admin_news.edit.title") %></h1>
<p class="mb-6 text-sm text-ink-muted"><%= t("admin_news.show.created_at", date: format_date(@news.created_at)) %></p>

<%= form_with model: @news, url: admin_news_path(@news), method: :patch do |f| %>
  <%= render "form", f: f %>
<% end %>
