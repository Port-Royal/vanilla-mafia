<% if f.object.errors.any? %>
  <div class="vm-errors">
    <ul class="list-inside list-disc">
      <% f.object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% label_classes = "w-40 shrink-0 pt-2 text-sm font-semibold text-ink sm:text-right" %>
<div class="vm-panel mb-6">
  <div class="divide-y divide-line-soft">
    <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row">
      <%= f.label :title, class: label_classes %>
      <%= f.text_field :title, class: "vm-input", required: true %>
    </div>

    <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row">
      <%= f.label :content, class: label_classes %>
      <div class="w-full">
        <%= f.rich_text_area :content, class: "w-full bg-white", style: "min-height: 20em" %>
      </div>
    </div>

    <% if f.object.photos.attached? %>
      <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row">
        <span class="<%= label_classes %>"><%= t("admin_news.form.photos") %></span>
        <div class="flex flex-wrap gap-2">
          <% f.object.photos.each do |photo| %>
            <% if photo.variable? %>
              <%= image_tag news_photo_variant(photo, :admin_form), alt: f.object.title, class: "rounded-md" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row">
      <%= f.label :photos, t("admin_news.form.add_photos"), class: label_classes %>
      <%= f.file_field :photos, multiple: true, class: "vm-file pt-1", accept: "image/*" %>
    </div>

    <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row">
      <%= f.label :published_at, t("admin_news.form.published_at"), class: label_classes %>
      <%= f.datetime_local_field :published_at, class: "vm-input" %>
    </div>

    <% selected_competition = f.object.competition %>
    <% selected_season_id = selected_competition ? (selected_competition.parent_id || selected_competition.id) : nil %>
    <div class="flex flex-col items-start gap-2 px-4 py-3 sm:flex-row"
         data-controller="cascade-select"
         data-cascade-select-options-value="<%= @stages_by_season.transform_values { |stages| stages.map { |s| [s.name, s.id] } }.to_json %>">
      <%= f.label :competition_id, t("admin_news.form.season"), class: label_classes %>
      <div class="flex w-full gap-2">
        <select data-cascade-select-target="parent" data-action="cascade-select#updateChild"
                class="vm-input w-1/2">
          <option value=""></option>
          <% @seasons.each do |season| %>
            <option value="<%= season.id %>" <%= "selected" if season.id == selected_season_id %>><%= season.name %></option>
          <% end %>
        </select>
        <%= f.select :competition_id,
              options_from_collection_for_select(@stages_by_season.values.flatten, :id, :name, f.object.competition_id),
              { include_blank: true },
              class: "vm-input w-1/2",
              data: { cascade_select_target: "child", selected_value: f.object.competition_id } %>
      </div>
    </div>
  </div>
</div>

<div class="mt-4 flex flex-wrap justify-end gap-2">
  <%= f.submit local_assigns[:submit_label] || (f.object.new_record? ? t("admin_news.form.submit_create") : t("admin_news.form.submit_update")),
        class: "vm-btn vm-btn--primary" %>
  <% if f.object.persisted? && f.object.draft? %>
    <button type="submit" name="publish" value="1" class="vm-btn vm-btn--ghost">
      <%= t("admin_news.form.submit_save_and_publish") %>
    </button>
  <% end %>
</div>
