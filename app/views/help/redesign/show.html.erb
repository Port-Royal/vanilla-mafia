<% title = t("help.pages.#{@slug}.title") %>
<% body = render("help/redesign/pages/#{@slug}") %>
<% sections = help_sections %>

<nav aria-label="Breadcrumb" class="mb-1.5 text-xs text-ink-muted">
  <%= link_to t("help.index.title"), help_index_path,
        class: "text-ink-muted underline decoration-gold-line underline-offset-3 hover:text-ink" %> /
  <span aria-current="page"><%= title %></span>
</nav>

<h1 class="mb-5 font-serif text-[22px] font-bold text-ink lg:text-[28px]"><%= title %></h1>

<div class="grid gap-6 lg:grid-cols-[minmax(0,680px)_200px] lg:gap-10">
  <% if sections.size > 1 %>
    <nav id="help-contents" aria-label="<%= t("help.redesign.contents") %>"
         class="vm-panel self-start px-4 py-3 lg:sticky lg:top-6 lg:col-start-2 lg:row-start-1 lg:border-0 lg:bg-transparent lg:p-0">
      <p class="vm-label mb-2" aria-hidden="true"><%= t("help.redesign.contents") %></p>
      <ol class="space-y-1.5 text-[13px]">
        <% sections.each do |section| %>
          <li>
            <%= link_to section.title, "##{section.anchor}", class: "text-ink-muted hover:text-ink hover:underline" %>
          </li>
        <% end %>
      </ol>
    </nav>
  <% end %>

  <div id="help-body" class="help-prose min-w-0 text-[15.5px] text-ink lg:col-start-1 lg:row-start-1 lg:text-base">
    <%= body %>
  </div>
</div>
