<h1 class="mb-4 font-serif text-[22px] font-bold text-ink lg:text-[28px]"><%= t("help.index.title") %></h1>

<ul id="help-pages" class="vm-panel max-w-[680px] divide-y divide-line-soft">
  <% @pages.each do |slug| %>
    <li>
      <%= link_to help_path(slug:), class: "group flex items-center gap-3 px-4 py-3 text-ink hover:bg-gold-wash focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" do %>
        <span class="min-w-0 flex-1">
          <span data-part="title" class="block text-[15px] font-semibold group-hover:underline"><%= t("help.pages.#{slug}.title") %></span>
          <span data-part="summary" class="mt-0.5 block text-[13px] text-ink-muted"><%= t("help.pages.#{slug}.summary") %></span>
        </span>
        <span aria-hidden="true" class="flex-none text-lg text-ink-muted">›</span>
      <% end %>
    </li>
  <% end %>
</ul>
