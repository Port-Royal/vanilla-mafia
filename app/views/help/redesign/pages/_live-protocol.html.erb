<% scope = "help.pages.live-protocol" %>

<p data-part="intro" class="help-intro"><%= t("intro", scope:) %></p>

<%= help_heading "start", t("start_title", scope:) %>

<ol>
  <% t("start", scope:).each do |step| %>
    <li><%= step %></li>
  <% end %>
</ol>

<%= help_heading "keys", t("keys_title", scope:) %>

<p><%= t("keys_intro", scope:) %></p>

<% %w[all roles deal speech vote night leaving].each do |stage| %>
  <h3><%= t("stages.#{stage}", scope:) %></h3>
  <div class="help-table vm-panel">
    <table class="vm-table">
      <thead>
        <tr><th class="w-px"><%= t("key", scope:) %></th><th><%= t("action", scope:) %></th></tr>
      </thead>
      <tbody>
        <% t("rows.#{stage}", scope:).each do |key, action| %>
          <tr>
            <td class="whitespace-nowrap"><%= help_key_caps(key) %></td>
            <td><%= action %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% %w[undo roles network after].each do |section| %>
  <%= help_heading section, t("#{section}_title", scope:) %>
  <p><%= t(section, scope:) %></p>
<% end %>
