<h1 class="vm-page-title mb-4"><%= t(".title") %></h1>

<div class="vm-panel mb-6 p-4" data-controller="clipboard">
  <h2 class="vm-label mb-2"><%= t(".feed_url_title") %></h2>
  <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap">
    <input type="text"
           readonly
           value="<%= podcast_feed_url(format: :rss, token: @feed_token.token) %>"
           data-clipboard-target="source"
           class="vm-input min-w-0 flex-1 text-ink-muted select-all">
    <button data-action="click->clipboard#copy"
            data-clipboard-target="button"
            class="vm-btn vm-btn--primary shrink-0">
      <%= t(".copy") %>
    </button>
  </div>
  <p class="mt-2 text-xs text-ink-muted">
    <%= t(".feed_url_hint") %>
    <%= link_to t(".feed_url_help"), help_path(slug: "podcast-feed"), class: "vm-link" %>
  </p>
</div>

<% if @episodes.any? %>
  <div class="vm-panel divide-y divide-line-soft">
    <% @episodes.each do |episode| %>
      <article class="px-4 py-4">
        <h2 class="text-lg font-semibold">
          <%= link_to episode.title, podcast_episode_path(episode), class: "text-ink hover:underline" %>
        </h2>
        <% if episode.published_at.present? %>
          <div class="mt-0.5 text-xs text-ink-muted"><%= format_datetime(episode.published_at) %></div>
        <% end %>
        <% if episode.description.present? %>
          <p class="mt-2 text-sm text-ink"><%= truncate(episode.description, length: 300) %></p>
        <% end %>
      </article>
    <% end %>
  </div>

  <%= render "shared/paper_pagy_nav", pagy: @pagy %>
<% else %>
  <p class="text-sm text-ink-muted"><%= t(".empty") %></p>
<% end %>
