<div class="mb-2">
  <%= link_to t(".back"), podcast_episodes_path, class: "vm-link text-xs text-ink-muted" %>
</div>

<h1 class="vm-page-title mb-1"><%= @episode.title %></h1>

<div class="mb-6 text-xs text-ink-muted">
  <% if @episode.published_at.present? %>
    <%= format_datetime(@episode.published_at) %>
  <% end %>
</div>

<% if @episode.audio.attached? %>
  <div class="vm-panel mb-6 p-4"
       data-controller="audio-player"
       data-audio-player-saved-position-value="<%= @saved_position %>"
       data-audio-player-saved-speed-value="<%= @saved_speed %>"
       data-audio-player-episode-title-value="<%= @episode.title %>"
       data-audio-player-position-url-value="<%= podcast_episode_position_path(@episode) %>"
       data-audio-player-play-label-value="<%= t(".play") %>"
       data-audio-player-pause-label-value="<%= t(".pause") %>">

    <audio data-audio-player-target="audio"
           data-action="loadedmetadata->audio-player#audioLoaded
                        timeupdate->audio-player#timeUpdate
                        play->audio-player#playing
                        pause->audio-player#paused
                        ended->audio-player#ended"
           src="<%= url_for(@episode.audio) %>"
           preload="metadata">
    </audio>

    <div class="flex items-center gap-3">
      <button data-audio-player-target="playButton"
              data-action="click->audio-player#togglePlay"
              aria-label="<%= t(".play") %>"
              class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink text-lg text-gold-bright hover:bg-ink/90">
        ▶
      </button>

      <span data-audio-player-target="currentTime"
            class="w-12 shrink-0 text-right text-sm text-ink-muted tabular-nums">0:00</span>

      <div data-audio-player-target="progress"
           data-action="mousedown->audio-player#seekStart
                        mousemove@window->audio-player#seekMove
                        mouseup@window->audio-player#seekEnd
                        touchstart->audio-player#seekStart
                        touchmove@window->audio-player#seekMove
                        touchend@window->audio-player#seekEnd
                        keydown->audio-player#seekKeyboard"
           role="slider"
           tabindex="0"
           aria-label="<%= t(".seek") %>"
           aria-valuenow="0"
           aria-valuemin="0"
           aria-valuemax="100"
           class="relative h-2 flex-1 cursor-pointer rounded-full bg-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
        <div data-audio-player-target="progressBar"
             class="h-full rounded-full bg-gold transition-[width] duration-100"
             style="width: 0%"></div>
      </div>

      <span data-audio-player-target="duration"
            class="w-12 shrink-0 text-sm text-ink-muted tabular-nums">0:00</span>

      <button data-audio-player-target="speedButton"
              data-action="click->audio-player#cycleSpeed"
              aria-label="<%= t(".playback_speed") %>"
              class="shrink-0 rounded-md border border-[#d8cba9] px-2 py-1 text-sm font-medium text-ink hover:bg-gold-wash">
        1x
      </button>
    </div>
  </div>
<% else %>
  <div id="audio-player-placeholder" class="vm-panel mb-6 p-6" data-saved-position="<%= @saved_position %>">
    <p class="text-center text-sm text-ink-muted"><%= t(".audio_player_coming_soon") %></p>
  </div>
<% end %>

<% if @episode.description.present? %>
  <div class="max-w-[680px] space-y-3.5 leading-[1.65] text-ink">
    <%= simple_format(@episode.description) %>
  </div>
<% end %>
