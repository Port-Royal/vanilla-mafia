<h1 class="vm-page-title mb-4"><%= t(".title") %></h1>

<% if @playlists.any? %>
  <div class="vm-panel divide-y divide-line-soft">
    <% @playlists.each do |playlist| %>
      <article class="px-4 py-3">
        <h2 class="text-lg font-semibold">
          <%= link_to playlist.title, podcast_playlist_path(playlist), class: "text-ink hover:underline" %>
        </h2>
        <div class="mt-0.5 text-xs text-ink-muted">
          <%= t(".episode_count", count: playlist.playlist_episodes.size) %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-ink-muted"><%= t(".empty") %></p>
<% end %>
