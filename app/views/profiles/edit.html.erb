<div class="mx-auto max-w-sm">
  <h1 class="vm-page-title mb-4"><%= t(".title") %></h1>

  <%= form_with(model: @player, url: profile_path, method: :patch) do |f| %>
    <% if @player.errors.any? %>
      <div class="vm-errors">
        <ul class="list-disc pl-5">
          <% @player.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="vm-panel space-y-4 p-6">
      <div>
        <%= f.label :name, t(".name_label"), class: "vm-field-label" %>
        <p class="mb-1 text-xs text-ink-muted"><%= t(".name_hint") %></p>
        <%= f.text_field :name, class: "vm-input" %>
      </div>

      <div>
        <%= f.label :bio, t(".bio_label"), class: "vm-field-label" %>
        <%= f.text_area :bio, rows: 4, class: "vm-input" %>
      </div>

      <% if current_user.admin? %>
        <div>
          <%= f.label :comment, t(".comment_label"), class: "vm-field-label" %>
          <%= f.text_area :comment, rows: 4, class: "vm-input" %>
        </div>
      <% end %>

      <div>
        <%= f.label :photo, t(".photo_label"), class: "vm-field-label" %>
        <div class="mb-2">
          <% if @player.photo.attached? %>
            <%= image_tag url_for(@player.photo.variant(resize_to_fill: [96, 96])), alt: @player.name, class: "size-24 rounded-full object-cover" %>
          <% else %>
            <%= image_tag Player::DEFAULT_PHOTO_PATH, alt: @player.name, class: "size-24 rounded-full object-cover" %>
          <% end %>
        </div>
        <%= f.file_field :photo, accept: "image/*", class: "vm-file" %>
      </div>

      <div>
        <%= f.submit t(".save"), class: "vm-btn vm-btn--primary w-full" %>
      </div>
    </div>
  <% end %>

  <%= form_with(url: datetime_format_path, method: :patch, class: "vm-panel mt-6 p-6") do |f| %>
    <fieldset>
      <legend class="vm-field-label mb-2"><%= t(".datetime_format_label") %></legend>
      <div class="space-y-2">
        <% User.datetime_formats.keys.each do |fmt| %>
          <label class="flex items-center gap-2 text-sm text-ink">
            <%= f.radio_button :datetime_format, fmt,
                  checked: fmt == Current.datetime_format,
                  class: "size-4 accent-ink" %>
            <span><%= t("datetime_formats.#{fmt}") %></span>
          </label>
        <% end %>
      </div>
      <div class="mt-4">
        <%= f.submit t(".save_datetime_format"), class: "vm-btn vm-btn--ghost w-full" %>
      </div>
    </fieldset>
  <% end %>
</div>
