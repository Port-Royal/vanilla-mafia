<div class="mx-auto max-w-sm">
  <h1 class="vm-page-title mb-4"><%= t("devise.passwords.edit.title") %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="vm-panel space-y-4 p-6">
      <div>
        <%= f.label :password, t("activerecord.attributes.user.password"), class: "vm-field-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "vm-field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.submit t("devise.passwords.edit.change_password"),
              class: "vm-btn vm-btn--primary w-full" %>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
