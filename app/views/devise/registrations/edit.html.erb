<div class="mx-auto max-w-sm">
  <h1 class="vm-page-title mb-4"><%= t("devise.registrations.edit.title") %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="vm-panel space-y-4 p-6">
      <div>
        <%= f.label :email, class: "vm-field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.label :password, class: "vm-field-label" %>
        <p class="mb-1 text-xs text-ink-muted">
          (<%= t("devise.registrations.edit.leave_blank") %>)
        </p>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "vm-field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.label :current_password, class: "vm-field-label" %>
        <p class="mb-1 text-xs text-ink-muted">
          (<%= t("devise.registrations.edit.current_password_hint") %>)
        </p>
        <%= f.password_field :current_password, autocomplete: "current-password",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.submit t("devise.registrations.edit.update"),
              class: "vm-btn vm-btn--primary w-full" %>
      </div>
    </div>
  <% end %>

  <div class="vm-panel mt-8 p-6">
    <h2 class="mb-3 text-lg font-semibold text-alert-ink"><%= t("devise.registrations.edit.cancel_account") %></h2>
    <%= button_to t("devise.registrations.edit.cancel_account"), registration_path(resource_name),
          method: :delete,
          data: { turbo_confirm: t("devise.registrations.edit.cancel_confirm") },
          class: "vm-btn vm-btn--danger" %>
  </div>

  <%= render "devise/shared/links" %>
</div>
