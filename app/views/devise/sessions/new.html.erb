<div class="mx-auto max-w-sm">
  <h1 class="vm-page-title mb-4"><%= t("devise.sessions.new.title") %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="vm-panel space-y-4 p-6">
      <div>
        <%= f.label :email, class: "vm-field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "vm-input" %>
      </div>

      <div>
        <%= f.label :password, class: "vm-field-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "vm-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "size-4 accent-ink" %>
          <%= f.label :remember_me, class: "text-sm text-ink" %>
        </div>
      <% end %>

      <div>
        <%= f.submit t("devise.sessions.new.sign_in"),
              class: "vm-btn vm-btn--primary w-full" %>
      </div>
    </div>
  <% end %>

  <div class="relative my-6">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-line"></div>
    </div>
    <div class="relative flex justify-center text-sm">
      <span class="bg-paper px-2 text-ink-muted"><%= t("devise.shared.links.or") %></span>
    </div>
  </div>

  <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
        class: "vm-btn vm-btn--ghost w-full", form_class: "w-full" do %>
    <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
    </svg>
    <%= t("devise.shared.links.sign_in_with_google") %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
