<article id="document-article" class="max-w-[680px]">
  <nav aria-label="Breadcrumb" class="mb-1.5 text-xs text-ink-muted">
    <%= link_to t("documents.index.title"), documents_path,
          class: "text-ink-muted underline decoration-gold-line underline-offset-3 hover:text-ink" %> /
    <span aria-current="page"><%= @document.title %></span>
  </nav>

  <h1 class="mb-5 font-serif text-[22px] font-bold text-ink lg:text-[28px]"><%= @document.title %></h1>

  <% if @document.body.present? %>
    <div data-part="body" class="news-prose text-[15.5px] text-ink lg:text-base">
      <%= @document.body %>
    </div>
  <% else %>
    <p id="documents-empty" class="text-sm text-ink-muted"><%= t("common.coming_soon") %></p>
  <% end %>
</article>
